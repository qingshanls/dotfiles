    blur {
        passes 2
        offset 3.0
        noise 0.02
        saturation 1.4
    }

    layer-rule {
        match namespace="^noctalia-backdrop$"
        place-within-backdrop true
    }

    window-rule {
        geometry-corner-radius 8 // Set every window radius to 20
        opacity 1.0
        clip-to-geometry true
        draw-border-with-background false
    }


    window-rule {
        match app-id="copyq"
        open-floating true
    }

    window-rule {
        match app-id="kitty"  // 终端
        opacity 0.75
        open-floating false
    }

    window-rule {
        match app-id="btop"  
        opacity 0.8
        open-floating false
    }
    
    window-rule {
        match app-id="com.microsoft.VSCode"
        draw-border-with-background false
        opacity 0.8
    } 

    window-rule {
        match app-id="pycharm"
        opacity 0.93
        draw-border-with-background false
    }
    window-rule {
        match app-id="splayer"
        draw-border-with-background false
    }

    window-rule {
        match app-id="obsidian"
        opacity 0.8
        draw-border-with-background false
    }
    
    
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        opacity 0.8
        draw-border-with-background false
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    window-rule {
        match app-id="com.follow.clash"
        open-floating true
        default-column-width { fixed 896; }
        default-window-height { fixed 733; }
    }
    
    layer-rule {
        match namespace="noctalia-wallpaper" 
        place-within-backdrop true
        background-effect {
          blur true
          xray false
       }
    }
    
    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
           xray false
           blur false
       }
   }